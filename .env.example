# Configuración de Entorno Local — PDUL Maturín

# ------------------------------------------------------------------------------
# Backend (FastAPI / SQLAlchemy)
# ------------------------------------------------------------------------------
# Para desarrollo local rápido con SQLite:
DATABASE_URL=sqlite+aiosqlite:///pdul_dev.db

# Para entorno local o producción con PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://pdul_user:pdul_password@localhost:5432/pdul_db

# Orígenes CORS permitidos (separados por coma o '*' para desarrollo)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Ruta al esquema canónico PDUL
DEFAULT_PDUL_SCHEMA_PATH=shared/schemas/pdul_origen_destino.json

# Entorno de ejecución (development | production | testing)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Frontend (Vite / Vue 3)
# ------------------------------------------------------------------------------
# URL base de la API FastAPI
VITE_API_BASE_URL=http://localhost:8000

